# ====================================================================
#  DOMINION ⛓️ — environment template
#
#  Copy to `.env` for local development, and set the same values in your
#  host's dashboard for production (Vercel: Project → Settings →
#  Environment Variables).
#
#  ⚠️  Every VITE_ value is inlined at BUILD time. Changing one after a
#      build has run does nothing until you redeploy.
# ====================================================================

# ---- Firebase (client) ---------------------------------------------
# Project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=house-of-dom.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=house-of-dom
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Storage bucket ---------------------------------------
# Optional: the code already falls back to this exact value, so an unset
# variable can never produce an empty bucket path (/v0/b//o/).
# A `gs://` prefix, a pasted URL or a trailing slash are all normalised.
VITE_FIREBASE_STORAGE_BUCKET=house-of-dom.firebasestorage.app

# ---- House ----------------------------------------------------------
# Which house document this client reads and writes.
VITE_HOUSE_ID=house-of-ash

# ---- Telegram (optional) --------------------------------------------
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_RELAY_URL=/api/telegram/send

# ---- Web push (optional) --------------------------------------------
VITE_VAPID_PUBLIC_KEY=

# ====================================================================
#  SERVER ONLY — never prefix these with VITE_, they are read by /api/*
# ====================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=house-of-dom
FIREBASE_API_KEY=
HOUSE_ID=house-of-ash
APP_URL=
APP_ORIGIN=*
