rules_version = '2';

// ============================================================
//  DOMINION ⛓️  — Firebase Storage rules
//
//  ⚠️  THIS APP NO LONGER USES FIREBASE STORAGE.
//
//  It was dropped for two reasons: it requires a paid (Blaze) project,
//  and its CORS preflight fails from this app's single-file static
//  build. Every image is now compressed in the browser and stored
//  inline in Firestore as a base64 data: URL — see src/lib/storage.ts
//  and SETUP.md §4.
//
//  Publishing the rules below is OPTIONAL. It is defence in depth:
//
//    • writes are refused, so nothing new can be uploaded to a bucket
//      the app does not use (and nothing can be billed for it)
//    • reads stay open, so images uploaded while Storage was still in
//      use keep rendering — old messages hold https URLs pointing here
//
//  Firebase Console → Storage → Rules → Publish
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Legacy media, readable so old documents keep working. Nothing may
    // be written: the client has no Storage SDK in it any more, so any
    // write attempt is either a mistake or an attacker.
    match /dominion-media/{houseId}/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else: no access at all.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
